{
  "name": "d2l-hub",
  "private": true,
  "version": "0.1.3",
  "description": "A dark-mode desktop dashboard for D2L (Brightspace)",
  "author": "D2L Hub",
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "d2l-hub.desktop",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:preview": "concurrently -n api,web -c magenta,cyan \"npm:dev:api:preview\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:api:preview": "tsx server/index.ts --demo",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "tsx server/index.ts",
    "icon": "node scripts/make-icon.mjs",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win -c.electronDist=node_modules/electron/dist",
    "dist:win:dir": "npm run build && electron-builder --win --dir -c.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "install:app": "node scripts/install-app.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "node-ical": "^0.27.3",
    "pdfjs-dist": "^5.7.284",
    "puppeteer-core": "^25.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
